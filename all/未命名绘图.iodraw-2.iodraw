          <mxGeometry x="40" y="125" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-6" value="下一轮事件队列" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="X-h-Y5wg-1FgEsjnu-qM-3">
          <mxGeometry x="40" y="212" width="120" height="60" as="geometry" />
