        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-20" value="初始化事件对象与连接管理对象" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="1754" y="613.5" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-21" value="初始化事件对象和连接管理对象槽位，方便后续写入，具体槽位数量由参数：worker_connections控制，默认1024个" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1726" y="440" width="176" height="84" as="geometry" />
