          </mxGeometry>
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-69" value="新连接的套接字登记到通知实例中" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
