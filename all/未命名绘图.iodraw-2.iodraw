        <mxCell id="NEyjl3xciexzlBsbwED4-3" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="NEyjl3xciexzlBsbwED4-4" target="NEyjl3xciexzlBsbwED4-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-4" value="&lt;div&gt;SELECT A.&quot;患者姓名&quot;, B.&quot;医嘱名称&quot;, B.&quot;金额&quot;, B.&quot;开立时间&quot;&lt;/div&gt;&lt;div&gt;FROM his_demo.&quot;患者信息&quot; AS A&lt;/div&gt;&lt;div&gt;JOIN his_demo.&quot;医嘱记录&quot; AS B ON B.&quot;患者ID&quot; = A.&quot;患者ID&quot;&lt;/div&gt;&lt;div&gt;WHERE A.&quot;科室编码&quot; = &#39;CARD&#39;;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontColor=#000000;align=left;" vertex="1" parent="1">
          <mxGeometry x="-426" y="202" width="360" height="71" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-5" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="NEyjl3xciexzlBsbwED4-13" target="NEyjl3xciexzlBsbwED4-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-6" value="剪枝：&lt;br&gt;根据表的扫描方式、依赖表等因素，淘汰掉成本更高的扫描方式&lt;br&gt;例如A6被A4淘汰的原因时，都依赖B，但是A4的成本更低、且还是有序的" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="1252" y="-272" width="256" height="156" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-7" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="-497" y="-1089" width="956" height="175" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-10" value="统计信息数据：&lt;br&gt;B表一共120000条数据" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="321" y="679" width="153" height="60" as="geometry" />
        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-11" value="&lt;div style=&quot;text-align: left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;span&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span&gt;运行成本根据扫描方式不同有不同的计算方式&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span&gt;以A1举例，因为是全表顺序扫描，基本不需要初始化，&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span&gt;所以一次性成本为0，而运行成本的话：&lt;/span&gt;&lt;/div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;运行成本&lt;/span&gt;&lt;/div&gt;&lt;code&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;≈ 表页数 × seq_page_cost + 表元组数 × cpu_tuple_cost&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;+ 条件判断成本&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;&amp;nbsp; =(1.0×表总页数)+(0.01×表总行数)+(0.0025×表总行数)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;= 217 + 0.01 x 20000 + 0.0025 x 20000&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;= 217 + 200 + 50&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;span style=&quot;font-family: &amp;#34;helvetica&amp;#34; ; white-space: normal&quot;&gt;= 467&lt;/span&gt;&lt;/div&gt;&lt;/code&gt;&lt;/pre&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;hachureGap=4;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="808.33" y="-509" width="453.67" height="301" as="geometry" />
        </mxCell>
