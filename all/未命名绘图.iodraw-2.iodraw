          <mxGeometry x="2645" y="1006" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-51" value="查找最近的要到期的，设置子进程最晚的 启动时间 就是 事件超时 子进程必须醒来然后执行；" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2847" y="1003" width="193" height="61" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-52" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-54" target="X-h-Y5wg-1FgEsjnu-qM-55">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-53" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-54" target="X-h-Y5wg-1FgEsjnu-qM-57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-54" value="调用等待接口" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="2449" y="1003" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-55" value="向操作系统申请就绪结果，如果没有，就继续等待，同时设置等待的时长上限，这个是动态计算；" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2443" y="887" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-56" value="" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-57" target="X-h-Y5wg-1FgEsjnu-qM-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-57" value="操作系统接收请求" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="2258" y="1004" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-58" value="" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-59" target="X-h-Y5wg-1FgEsjnu-qM-62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-59" value="生成就绪事件等待调用" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="2075" y="1004" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-60" value="" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-62" target="X-h-Y5wg-1FgEsjnu-qM-63">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-61" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-62" target="X-h-Y5wg-1FgEsjnu-qM-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-62" value="通知Ng等待调用接口可以返回事件" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="1892" y="1006" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-63" value="可能返回多条事件：&lt;br&gt;1. 客户端A连接可读；&lt;br&gt;2. 客户端B连接可写；" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1883" y="893" width="138" height="51" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-64" value="包含监听对象可读事件，读事件中就有之前了解到的，接收处理函数" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1471" y="887" width="151" height="61" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-65" value="1. 先通过协议处理函数，解析HTTP；&lt;br&gt;&lt;br&gt;2. 设置读写事件的处理函数；&lt;br&gt;&lt;br&gt;3.计算本次执行等待的到期时间；&lt;br&gt;&lt;br&gt;4.把这个时间写入超时结构的红黑树中；" style="whiteSpace=wrap;html=1;hachureGap=4;align=left;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1019" y="833" width="226" height="115" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-66" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-69" target="X-h-Y5wg-1FgEsjnu-qM-70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;" edge="1" parent="1" source="X-h-Y5wg-1FgEsjnu-qM-69" target="X-h-Y5wg-1FgEsjnu-qM-50">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="984" y="1247" />
              <mxPoint x="2705" y="1247" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-68" value="登记完成后，继续等待" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="X-h-Y5wg-1FgEsjnu-qM-67">
          <mxGeometry x="-0.0244" y="-4" relative="1" as="geometry">
