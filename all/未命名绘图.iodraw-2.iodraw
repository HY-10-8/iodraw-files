          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-24" value="存储共享监听入口" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
          <mxGeometry x="1986" y="613.5" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-25" value="Nginx把每个子进程的监听入口作为一个对象存储于第一个连接对象中，包含相关的：监听套接字编号、读写事件引用等管理信息" style="whiteSpace=wrap;html=1;hachureGap=4;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
