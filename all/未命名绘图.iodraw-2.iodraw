        <mxCell id="X-h-Y5wg-1FgEsjnu-qM-30" value="&lt;span&gt;在通知实例中登记&lt;/span&gt;" style="whiteSpace=wrap;html=1;hachureGap=4;" vertex="1" parent="1">
