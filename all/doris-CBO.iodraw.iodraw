        </mxCell>
        <mxCell id="NEyjl3xciexzlBsbwED4-16" value="过滤条件:&lt;br&gt;B.&quot;患者ID&quot; = A.&quot;患者ID&quot;&lt;br&gt;&lt;span style=&quot;text-align: left&quot;&gt;A.&quot;科室编码&quot; = &#39;CARD&#39; &lt;br&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;align=center;verticalAlign=middle;" vertex="1" parent="NEyjl3xciexzlBsbwED4-12">
