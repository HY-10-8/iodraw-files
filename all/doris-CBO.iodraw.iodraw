        <mxCell id="NEyjl3xciexzlBsbwED4-276" value="&lt;div&gt;SELECT c.name, o.amount&lt;/div&gt;&lt;div&gt;FROM&amp;nbsp; &amp;nbsp;customer c&lt;/div&gt;&lt;div&gt;JOIN&amp;nbsp; &amp;nbsp;orders&amp;nbsp; o&amp;nbsp; ON c.id = o.cust_id&lt;/div&gt;&lt;div&gt;JOIN&amp;nbsp; &amp;nbsp;region&amp;nbsp; ra ON ra.id = c.region_id&lt;/div&gt;&lt;div&gt;WHERE&amp;nbsp; o.amount &amp;gt; 100 AND ra.name = &#39;华东&#39;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
