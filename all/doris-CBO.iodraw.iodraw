        <mxCell id="NEyjl3xciexzlBsbwED4-15" value="待查询的字段：&lt;br&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;A.&quot;患者编号&quot;,&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;A.&quot;患者姓名&quot;,&lt;br&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;B.&quot;医嘱名称&quot;,&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;B.&quot;金额&quot;, &lt;br&gt;&lt;span style=&quot;white-space: pre&quot;&gt;&#x9;&lt;/span&gt;B.&quot;开立时间&quot;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;align=left;verticalAlign=top;" vertex="1" parent="NEyjl3xciexzlBsbwED4-12">
