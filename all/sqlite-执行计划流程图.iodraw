        <mxCell id="27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" value="SELECT a.name &#xa;FROM users AS a&#xa;JOIN orders AS b ON b.user_id = a.id&#xa;WHERE b.status = &#39;paid&#39;;" vertex="1">
          <mxGeometry height="209" width="544" x="40" y="1020.5" as="geometry" />
        </mxCell>
        <mxCell id="61" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;fontSize=20;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;" value="" vertex="1">
          <mxGeometry height="285" width="272" x="3196" y="4047" as="geometry" />
