        <mxCell id="75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" value="对数计算：LogEst(N) ≈ 10 x log2(N)&#xa;全表扫描成本 = 预计行数 x 3 = L预计行数 + L16&#xa;当表在stat4中存在数据时 ≈ 预计行数 x 2.75 = L预计行数 + L14" vertex="1">
          <mxGeometry height="110" width="806" x="3553.55" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="76" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" value="组合后的总成本 ≈  A表的成本 + （A表预计行数 * B表成本）&#xa;=  对数值相加（L115，（L99 + L180））&#xa;=   对数值相加（L115，L279）&#xa;≈  L279" vertex="1">
          <mxGeometry height="150" width="580" x="4430" y="2900" as="geometry" />
