        <mxCell id="h48CHQcW-xhReIeVoeAo-130" value="&lt;br&gt;以A3 -&amp;gt; B1 成本的计算为例：&lt;br&gt;累计成本&lt;br&gt;≈&amp;nbsp;&lt;span&gt;外表成本&amp;nbsp;&lt;/span&gt;&lt;span&gt;+ 外表输出行数 × 内表重新执行成本&amp;nbsp;&lt;/span&gt;&lt;span&gt;+ 连接条件判断成本&lt;br&gt;=&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(15 , 17 , 21) ; font-family: &amp;#34;menlo&amp;#34; , &amp;#34;monaco&amp;#34; , &amp;#34;consolas&amp;#34; , &amp;#34;cascadia mono&amp;#34; , &amp;#34;ubuntu mono&amp;#34; , &amp;#34;dejavu sans mono&amp;#34; , &amp;#34;liberation mono&amp;#34; , &amp;#34;jetbrains mono&amp;#34; , &amp;#34;fira code&amp;#34; , &amp;#34;cousine&amp;#34; , &amp;#34;roboto mono&amp;#34; , &amp;#34;courier new&amp;#34; , &amp;#34;courier&amp;#34; , sans-serif , ; font-size: 13px&quot;&gt;798.29 + 3333 × 2779 = 798.29 + 9,262,407 &lt;br&gt;= 9,263,205.29&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;hachureGap=4;align=center;" parent="1" vertex="1">
