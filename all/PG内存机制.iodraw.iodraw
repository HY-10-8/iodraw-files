        <mxCell id="hsZLfapZjs0gfuHIcwkx-38" value="监督进程，是数据库的第一个进程，核心功能是接收客户端的连接请求，并启动Backend进程处理这个请求" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-1550" y="340" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-39" value="&lt;span style=&quot;text-align: left;&quot;&gt;实际数据处理，比如排序、哈希操作、会话状态、执行计划缓存等等&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-1805" y="611" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-40" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="-1830" y="621" as="sourcePoint" />
            <mxPoint x="-2070" y="621" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-41" value="存在各自的私有本地内存&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;用于实际数据处理，比如排序、哈希操作、会话状态、执行计划缓存等等，&lt;/div&gt;&lt;div&gt;临时内存，使用完后，会释放掉。&lt;/div&gt;&lt;div&gt;内存采用树形方式，便于统一销毁（一般以事务、查询结束为标志&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-2270" y="601" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-42" value="共享内存，主要用于数据页缓存、WAL日志缓冲区、统计信息等等&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;所有进程仅此一份，多个进程都会读取，所以会使用到锁、原子操作等机制保护使用&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-2270" y="330" width="200" height="110" as="geometry" />
        </mxCell>
