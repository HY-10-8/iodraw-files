        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-63" value="&lt;span style=&quot;font-weight: 600; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;walwriter&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;container=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="816" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-64" value="&lt;span style=&quot;font-weight: 600; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;autovacuum worker&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;container=0;" vertex="1" parent="1">
          <mxGeometry x="684" y="816" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-65" value="监督进程，是数据库的第一个进程，核心功能是接收客户端的连接请求，并启动Backend进程处理这个请求" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="418" y="56" width="173" height="95" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-66" value="&lt;span style=&quot;text-align: left;&quot;&gt;实际数据处理，比如排序、哈希操作、会话状态、执行计划缓存等等&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="169" y="486" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-67" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="164" y="496" as="sourcePoint" />
            <mxPoint x="-76" y="496" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-68" value="存在各自的私有&lt;b&gt;本地内存&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;用于实际数据处理，比如排序、哈希操作、会话状态、执行计划缓存等等，&lt;/div&gt;&lt;div&gt;临时内存，使用完后，会释放掉。&lt;/div&gt;&lt;div&gt;内存采用树形方式，便于统一销毁（一般以事务、查询结束为标志&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-276" y="456" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-69" value="&lt;b&gt;共享内存&lt;/b&gt;，主要用于数据页缓存、WAL日志缓冲区、统计信息等等&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;所有进程仅此一份，多个进程都会读取，所以会使用到锁、原子操作等机制保护使用&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;在实例启动时分配，大小固定&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="1">
          <mxGeometry x="-276" y="56" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-70" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="484" y="376" as="sourcePoint" />
            <mxPoint x="484" y="256" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-71" value="通过多种方式传递信号、数据&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通知：信号、Latch&lt;/div&gt;&lt;div&gt;共享状态：共享内存 + 锁&lt;/div&gt;&lt;div&gt;数据：DSM + shm_mq、socket、通过磁盘&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="504" y="266" width="250" height="101" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-72" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="484" y="776" as="sourcePoint" />
            <mxPoint x="484" y="656" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-73" value="通过多种方式传递信号、数据&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通知：信号、Latch&lt;/div&gt;&lt;div&gt;共享状态：共享内存 + 锁&lt;/div&gt;&lt;div&gt;数据：DSM + shm_mq、socket、通过磁盘&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="504" y="666" width="250" height="101" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-74" value="&lt;div&gt;&lt;font face=&quot;quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen, Ubuntu, Cantarell, Open Sans, Helvetica Neue, sans-serif&quot; color=&quot;#0f1115&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;PG的共享内存：&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;ul style=&quot;margin: 16px 0px; padding-left: 18px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot;&gt;&lt;span class=&quot;&quot;&gt;对于一台&lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;专用&lt;/span&gt;&lt;span class=&quot;&quot;&gt;的数据库服务器，且内存为 &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;1GB 或以上&lt;/span&gt;&lt;span class=&quot;&quot;&gt;，一个合理的&lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;起始值&lt;/span&gt;&lt;span class=&quot;&quot;&gt;是系统内存的 &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;25%&lt;/span&gt;&lt;span class=&quot;&quot;&gt;。&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 0px; margin-left: 0px; margin-top: 0px !important;&quot;&gt;&lt;span class=&quot;&quot;&gt;通常不建议超过系统内存的 &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;40%&lt;/span&gt;&lt;span class=&quot;&quot;&gt;，因为 PostgreSQL 同时也依赖操作系统的文件缓存来提升性能，给 &lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;shared_buffers&lt;/code&gt;&lt;span class=&quot;&quot;&gt; 分配过多内存反而可能降低整体效率。&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-right: 0px; margin-bottom: 0px; margin-left: 0px; margin-top: 0px !important;&quot;&gt;&lt;span class=&quot;&quot;&gt;默认128MB&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-226" y="1376" width="710" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-75" value="实现文件落盘、刷脏页、写WAL等等" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-276" y="816" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-76" value="" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="hsZLfapZjs0gfuHIcwkx-61">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="44" y="856" as="sourcePoint" />
            <mxPoint x="-76" y="831" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hsZLfapZjs0gfuHIcwkx-79" value="&lt;div&gt;PostgreSQL 内存管理&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── 共享内存（所有进程共享）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── shared_buffers（数据页缓存）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── WAL 缓冲区&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── 锁表&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── Commit Log&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── 保护机制：自旋锁 / 轻量级锁 / 原子操作&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── 本地内存（每个进程私有）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── MemoryContext 树（核心机制）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp;├── TopMemoryContext（根）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp;├── CacheMemoryContext（进程级）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp;├── TopTransactionContext（事务级）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp;├── ExecutorState（查询级）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp;└── ExprContext（表达式级）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── work_mem（操作级）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── maintenance_work_mem（维护操作）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── temp_buffers（临时表）&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── 配置参数（按作用域分层）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── shared_buffers（全局）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── work_mem（每操作）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── maintenance_work_mem（每维护操作）&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── temp_buffers（每会话）&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;└── 监控手段&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ├── pg_buffercache（共享缓存）&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ├── pg_backend_memory_contexts（本地上下文树）&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; └── pg_shmem_allocations（共享内存分配）&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-230" y="1580" width="530" height="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
