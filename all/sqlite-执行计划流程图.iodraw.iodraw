        </mxCell>
        <mxCell id="43" value="B5 （orders表）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fontColor=#ffffff;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
          <mxGeometry x="44.532679738562265" y="223.34850640113805" width="395.2908496732026" height="73.6045519203414" as="geometry" />
        </mxCell>
        <mxCell id="44" value="A2 需要依赖B表，丢弃" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#f7594b, #ff9281);strokeColor=#B20000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fontColor=#ffffff;gradientColor=none;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
          <mxGeometry x="45.10130718954257" y="336.47795163584647" width="395.2908496732026" height="73.6045519203414" as="geometry" />
        </mxCell>
        <mxCell id="45" value="B3 成本比#5更高 " style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#f7594b, #ff9281);strokeColor=#B20000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fontColor=#ffffff;gradientColor=none;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
          <mxGeometry x="42.44771241830057" y="446.1337126600282" width="395.2908496732026" height="72.85348506401137" as="geometry" />
        </mxCell>
        <mxCell id="46" value="B6 需要依赖A表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#f7594b, #ff9281);strokeColor=#B20000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fontColor=#ffffff;gradientColor=none;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
          <mxGeometry x="40.74183006535965" y="553.2546230440969" width="395.2908496732026" height="72.85348506401137" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-331" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;" parent="1" source="2" target="Vq3hVMW9N8FSbHExLnwD-234" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-332" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;" parent="1" source="2" target="Vq3hVMW9N8FSbHExLnwD-242" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2" value="#1 全表扫描，users表共1000条数据，转换为对数为：L99（行数据）&#xa;全表扫描得成本 = L行 + L16（偏移量） = 99 + 16 = L115&#xa;#3 全表扫描，orders表共100000条数据，转换为对数为：L166&#xa;但是这里还存在一个条件：b.status = ‘paid’，所以预计只会取到1/4左右得数据&#xa;预计行数 = L166 - L20 = L146&#xa;运行成本 = L166 + L16 = L182&#xa;但是因为orders表在stat4中存在有效数据，所以惩罚从x3变成x2.75：&#xa;L166 + L16 - L2 = L182" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="3530" y="1670" width="864" height="230" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-323" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="13" target="Vq3hVMW9N8FSbHExLnwD-246" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-328" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="13" target="Vq3hVMW9N8FSbHExLnwD-313" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-326" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;" parent="1" source="14" target="Vq3hVMW9N8FSbHExLnwD-303" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-327" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;" parent="1" source="14" target="Vq3hVMW9N8FSbHExLnwD-313" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Vq3hVMW9N8FSbHExLnwD-324" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;" parent="1" source="15" target="Vq3hVMW9N8FSbHExLnwD-250" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" value="SELECT a.name &#xa;FROM users AS a&#xa;JOIN orders AS b ON b.user_id = a.id&#xa;WHERE b.status = &#39;paid&#39;;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="160" y="1050.25" width="380" height="149.5" as="geometry" />
        </mxCell>
        <mxCell id="61" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;fontSize=20;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="3196" y="4047" width="272" height="285" as="geometry" />
        </mxCell>
        <mxCell id="75" value="对数计算：LogEst(N) ≈ 10 x log2(N)&#xa;全表扫描成本 = 预计行数 x 3 = L预计行数 + L16&#xa;当表在stat4中存在数据时 ≈ 预计行数 x 2.75 = L预计行数 + L14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="3553.55" y="1500" width="806" height="110" as="geometry" />
        </mxCell>
        <mxCell id="76" value="组合后的总成本 ≈  A表的成本 + （A表预计行数 * B表成本）&#xa;=  对数值相加（L115，（L99 + L180））&#xa;=   对数值相加（L115，L279）&#xa;≈  L279" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="4090" y="2200" width="580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="77" value="【对数值相加】在sqlite中，所有成本都是转换为LogEst后在进行计算得，所以直接计算加法需要特殊处理，在sqlite内部也提供了一个方法进行运算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="4370" y="2410" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="78" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;fontSize=20;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="2176" y="8170" width="884" height="855" as="geometry" />
        </mxCell>
        <mxCell id="79" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;strokeWidth=1;fontSize=20;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="2176" y="8170" width="884" height="855" as="geometry" />
        </mxCell>
        <mxCell id="80" value="计算组合后的成本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;" parent="1" vertex="1">
