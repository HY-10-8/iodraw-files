        <mxCell id="42" value="A1 （users表）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fontColor=#ffffff;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
