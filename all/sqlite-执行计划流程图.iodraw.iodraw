        <mxCell id="41" value="选出第一轮候选查询" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=20;align=left;verticalAlign=top;" parent="Vq3hVMW9N8FSbHExLnwD-347" vertex="1">
