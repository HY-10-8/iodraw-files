        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-8" value="词法分析：识别代码里的单词和符号&lt;div&gt;语法分析：识别代码含义&lt;/div&gt;&lt;div&gt;代码生成器：根据代码生成字节码&lt;/div&gt;&lt;div&gt;虚拟机：逐条执行字节码&lt;/div&gt;&lt;div&gt;调用帧：一次函数调用所需的执行记录和工作空间&lt;br&gt;C Api:&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="YK9fg9cT_8YSmuaUv1Kp-23" target="YK9fg9cT_8YSmuaUv1Kp-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-20" value="&lt;span style=&quot;&quot;&gt;local a = 10&lt;/span&gt;&lt;div style=&quot;&quot;&gt;local b = 20&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;local c = a + b&lt;/div&gt;&lt;div style=&quot;&quot;&gt;return c&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="240" y="440" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-21" value="&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;将 10 放入槽位 R0&lt;br&gt;将 20 放入槽位 R1&lt;br&gt;取出两个值，相加后把 30 放入 R2&lt;br&gt;把 30 返回给调用者&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="440" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="YK9fg9cT_8YSmuaUv1Kp-20" target="YK9fg9cT_8YSmuaUv1Kp-23">
