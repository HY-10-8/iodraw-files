        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-20" value="&lt;span style=&quot;&quot;&gt;local a = 10&lt;/span&gt;&lt;div style=&quot;&quot;&gt;local b = 20&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;local c = a + b&lt;/div&gt;&lt;div style=&quot;&quot;&gt;return c&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="240" y="440" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="YK9fg9cT_8YSmuaUv1Kp-21" value="&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;将 10 放入槽位 R0&lt;br&gt;将 20 放入槽位 R1&lt;br&gt;取出两个值，相加后把 30 放入 R2&lt;br&gt;把 30 返回给调用者&lt;/code&gt;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="760" y="440" width="200" height="90" as="geometry" />
        </mxCell>
